# Ignore everything by default
*

# --- Allowlist ---
# Allow directories to be tracked, so files inside them can be un-ignored
!*/

# Allow specific file extensions
!*.py
!*.tex
!*.txt
!*.log
!*.csv
!*.yaml
!*.md

# Allow specific files without extensions if needed (e.g., Dockerfile)
# !Dockerfile

!/thesis/

# --- Blocklist ---
# Re-ignore specific directories that should never be tracked
.git/
.gemini/
.idea/
.vscode/
__pycache__/
*.pyc

# Re-ignore dataset and run directories
venv/
Image_dataset/
training_runs/
SF/

/Image_dataset_3band/
/Image_dataset_pca_3band/
/dataset_40_for_test/
/run_full_manguon/

# Don't ignore the .gitignore file itself
!.gitignore
